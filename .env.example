DB_URL=jdbc:postgresql://localhost:5432/chamados
DB_USER=chamados_user
DB_PASSWORD=troque_esta_senha
PGADMIN_EMAIL=admin@suaempresa.com.br
PGADMIN_PASSWORD=troque_esta_senha_tambem
# Primeiro administrador (criado ao subir a aplicação, se ainda não houver nenhum)
# Acentos: o Spring lê este arquivo em ISO-8859-1; use escape Unicode (ã = \u00e3, ç = \u00e7, é = \u00e9).
# Ex.: ADMIN_NAME=Jo\u00e3o da Concei\u00e7\u00e3o
ADMIN_NAME=Seu Nome Completo
ADMIN_CPF=00000000000
ADMIN_EMAIL=seu.email@contabilizape.com.br
ADMIN_PASSWORD=umaSenhaComLetraE123
# Mostra no log o SQL de cada consulta (útil em desenvolvimento; em produção, omita).
SHOW_SQL=true
# Documentação da API (Swagger UI em /swagger-ui.html). Só em desenvolvimento; em produção, omita.
API_DOCS_ENABLED=true
# Chave que assina os tokens de login: base64 de 32 bytes aleatórios. Gere a sua (comando no README) e nunca reutilize a de outro ambiente.
JWT_SECRET=gere_a_sua_chave_aqui
# Cookie do login só por HTTPS. Navegadores aceitam em http://localhost; mude para false só se o seu não aceitar.
# COOKIE_SECURE=true
# Chave que cifra os comentários dos chamados (AES-256-GCM): base64 de 32 bytes aleatórios, gerada como a JWT_SECRET.
# Sem ela, a aplicação não sobe. Guarde uma cópia em local seguro: sem a chave, os comentários gravados não podem ser lidos.
CONTENT_ENCRYPTION_KEY=
# E-mails pelo Resend. Vazio: os e-mails só são registrados no log (desenvolvimento).
# Em produção: chave com permissão só de envio, restrita ao domínio do remetente.
RESEND_API_KEY=
# Remetente (domínio verificado no Resend). Se omitido, usa notificacoes.contabilizape.com.br.
# EMAIL_FROM=CentralDesk <centraldesk@notificacoes.contabilizape.com.br>
# Endereço do front-end, usado nos links dos e-mails.
FRONT_BASE_URL=http://localhost:5173
# true: a aplicação não sobe sem RESEND_API_KEY. No Railway isso já vale sempre (os códigos de acesso não podem ir para o log).
# EMAIL_REQUIRED=true
# Sem RESEND_API_KEY, para ler no log os códigos de acesso enviados por e-mail (só em desenvolvimento):
# LOGGING_LEVEL_BR_COM_CONTABILIZAPE_CENTRALDESK_EMAIL_LOGGINGEMAILSENDER=DEBUG
